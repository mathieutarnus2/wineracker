rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne lit et n'écrit que ses propres données.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // L'abonnement n'est écrit que par le serveur (après confirmation de Stripe) ; l'utilisateur peut le lire.
    match /abonnements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Quotas et réglages internes : serveur uniquement.
    match /quotas/{uid} {
      allow read, write: if false;
    }
    match /systeme/{doc} {
      allow read, write: if false;
    }
  }
}
